# ==============================================================================
# Sushma Jewels - Frontend Environment Variables
# ==============================================================================
# Replace YOUR_RAILWAY_DOMAIN with your actual Railway service domain
# (e.g., https://sushma-backend-production.up.railway.app)
# Do NOT include a trailing slash at the end.
# ==============================================================================

# Backend API Endpoint (used for /products, /orders, /cart, /customers, etc.)
VITE_API_BASE_URL=https://jwel-backend-production.up.railway.app/api

# Backend Root Auth Endpoint (used for /admin/login)
VITE_AUTH_API_BASE_URL=https://jwel-backend-production.up.railway.app
